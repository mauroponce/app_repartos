<% content_for :title, "Reglas de oportunidades" %><div class="heading"><div><h1>Reglas de oportunidades</h1><p>Umbrales por empresa y tareas automáticas internas. No se envían mensajes a clientes.</p></div><%= link_to "Volver a reportes", reports_path, class: "btn btn-white" %></div><section class="management-panel"><%= form_with model: @settings, scope: :setting, url: commercial_rule_settings_path, method: :patch, class: "field-grid management-form" do |f| %><%= render "shared/validation_errors", record: @settings %>
<% { inactivity_min_days: "Inactividad mínima (días)", inactivity_multiplier: "Multiplicador de frecuencia habitual", comparison_days: "Duración de períodos comparados / ventana de problemas (días)", decline_min_orders: "Pedidos mínimos del período anterior", decline_percent: "Caída mínima de pedidos (%)", shortage_min_orders: "Pedidos mínimos con faltantes por producto/unidad", failure_min_orders: "Visitas con pedidos fallidos mínimas por cliente", partial_grace_days: "Espera para seguimiento de parciales (días)", cooldown_days: "Enfriamiento antes de reabrir una alerta gestionada (días)" }.each do |key, label| %><div class="field"><%= f.label key, label %><%= f.number_field key, min: 1, step: key == :inactivity_multiplier ? "0.1" : "1", required: true %></div><% end %><div class="field"><%= f.label :auto_assignee_id, "Responsable de tareas automáticas" %><%= f.collection_select :auto_assignee_id, @staff.select(&:manages_customers?), :id, :name, include_blank: "Seleccionar responsable" %></div><fieldset class="field full"><legend>Crear tareas automáticamente para estas reglas</legend><%= hidden_field_tag "setting[automatic_rules][]", "" %><% CommercialOpportunity::RULES.each do |key, label| %><label class="workflow-check"><%= check_box_tag "setting[automatic_rules][]", key, @settings.automatic_rules.include?(key) %><%= label %></label><% end %><p class="hint">Todas están desactivadas inicialmente. Se crea como máximo una tarea por oportunidad y ciclo de seguimiento.</p></fieldset><div class="form-actions full"><%= f.submit "Guardar configuración", class: "btn btn-dark" %></div><% end %></section>
