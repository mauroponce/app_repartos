<% content_for :title, "Entrega · #{@delivery_order.customer_name}" %>
<div class="breadcrumb"><%= link_to "Entregas", delivery_orders_path %><%= icon("chevron-right") %><strong>#<%= @delivery_order.id %></strong></div>
<div class="heading"><div><div class="eyebrow">Entrega #<%= @delivery_order.id %></div><h1><%= @delivery_order.customer_name %></h1><p><%= @delivery_order.customer_address %></p></div><div class="heading-actions"><% if @delivery_order.editable? %><%= link_to "Editar entrega", edit_delivery_order_path(@delivery_order), class: "btn btn-white" %><%= button_to "Cancelar entrega", cancel_delivery_order_path(@delivery_order), method: :post, class: "btn btn-white", data: { turbo_confirm: "¿Cancelar esta entrega? Se quitará de su hoja y se conservará el historial." } %><% end %></div></div>
<section class="management-panel">
  <div class="panel-heading"><div><h2><%= l(@delivery_order.scheduled_date) %> · <%= schedule_time(@delivery_order) %></h2><p><%= @delivery_order.delivery_schedule_id ? "Generada desde programación recurrente" : "Entrega puntual" %></p></div><span class="chip <%= @delivery_order.display_status %>"><%= delivery_order_status(@delivery_order) %></span></div>
  <% if @delivery_order.visit %><p class="drawer-note">Hoja de ruta: <%= link_to @delivery_order.visit.delivery_run.name, delivery_run_path(@delivery_order.visit.delivery_run), class: "text-action" %> · Parada <%= @delivery_order.visit.position %> · <%= operation_status(@delivery_order.visit.status) %></p><% elsif @delivery_order.pending? %><p class="drawer-note">Pendiente de planificación. <%= link_to "Crear hoja con esta entrega", new_delivery_run_path(order_ids: [@delivery_order.id]), class: "text-action" %></p><% end %>
  <% if @delivery_order.notes.present? %><p class="drawer-note"><%= @delivery_order.notes %></p><% end %>
  <div class="table-scroll" tabindex="0" role="region" aria-label="Productos solicitados y entregados"><table class="data-table"><thead><tr><th>Producto</th><th>Unidad</th><th>Solicitado</th><th>Entregado</th><th>Diferencia</th></tr></thead><tbody>
    <% @items.each do |item| %><tr><td><strong><%= item.description %></strong></td><td><%= DeliveryUnits::LABELS[item.unit] %></td><td><%= quantity_text(item.quantity) %></td><td><%= quantity_text(item.delivery_item&.delivered_quantity) %></td><td><%= item.delivery_item&.difference.nil? ? "—" : quantity_text(item.delivery_item.difference) %></td></tr><% end %>
  </tbody></table></div>
</section>
