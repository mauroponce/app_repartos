<%= form_with model: @product, class: "field-grid management-form product-form" do |form| %>
  <%= render "shared/validation_errors", record: @product %>
  <div class="field product-name"><%= form.label :name, "Nombre *" %><%= form.text_field :name, required: true, maxlength: 255 %></div>
  <div class="field product-sku"><%= form.label :sku, "SKU / código" %><%= form.text_field :sku, maxlength: 255 %></div>
  <div class="field product-unit"><%= form.label :unit, "Unidad de entrega *" %><%= form.select :unit, DeliveryUnits.options, { prompt: "Elegí una unidad" }, required: true %></div>
  <div class="field product-price"><%= form.label :unit_price, "Precio unitario (#{Current.company.currency})" %><%= form.number_field :unit_price, min: 0, step: "0.0001", placeholder: "Sin informar" %></div>
  <div class="field product-status"><%= form.label :active, "Estado" %><%= form.select :active, [["Activo", true], ["Inactivo", false]] %></div>
  <p class="hint full">El precio se copia al crear pedidos nuevos. Los pedidos existentes conservan sus precios históricos. Vacío significa desconocido; cero significa un valor informado de cero.</p>
  <div class="form-actions full"><%= link_to "Cancelar", products_path, class: "btn btn-white" %><%= form.submit "Guardar producto", class: "btn btn-dark", data: { turbo_submits_with: "Guardando..." } %></div>
<% end %>
