<% content_for :title, "#{@product.name} · App Repartos" %>
<% content_for :modal_page, "true" %>
<%= turbo_frame_tag "modal", target: "_top" do %>
  <dialog class="customer-dialog customer-dialog-location" data-controller="modal" data-modal-return-url-value="<%= products_path %>" data-action="click->modal#backdrop close->modal#closed" aria-labelledby="product-detail-title">
    <div class="modal-title"><div><h1 id="product-detail-title"><%= @product.name %></h1><p><%= Current.company.name %></p></div><%= link_to products_path, class: "icon-btn", aria: { label: "Cerrar detalle" }, data: { action: "modal#close" } do %><%= icon("close") %><% end %></div>
    <span class="chip <%= @product.active? ? 'active' : 'inactive' %>"><%= @product.active? ? "Activo" : "Inactivo" %></span>
    <dl class="drawer-data">
      <% [["SKU / código", @product.sku.presence || "Sin informar"], ["Unidad de entrega", DeliveryUnits::LABELS[@product.unit].capitalize], ["Precio unitario", historical_money(@product.unit_price)]].each do |label, value| %>
        <div class="drawer-data-row"><dt><%= label %></dt><dd><%= value %></dd></div>
      <% end %>
    </dl>
    <div class="form-actions"><%= link_to "Volver a productos", products_path, class: "btn btn-white", data: { action: "modal#close" } %><%= link_to edit_product_path(@product), class: "btn btn-dark", data: { turbo_frame: "_top" } do %><%= icon("edit") %>Editar producto<% end %></div>
  </dialog>
<% end %>
