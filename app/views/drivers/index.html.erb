<% content_for :title, "Repartidores · App Repartos" %>
<div class="breadcrumb"><span>Operación</span><%= icon("chevron") %><strong>Repartidores</strong></div>
<div class="heading">
  <div><div class="eyebrow">Equipo</div><h1>Repartidores</h1><p>Administrá tu equipo, sus datos de contacto y el acceso a los repartos.</p></div>
  <div class="heading-actions"><%= link_to new_driver_path, class: "btn btn-dark", data: { turbo_frame: "modal" } do %><%= icon("plus") %> Nuevo repartidor<% end %></div>
</div>
<section class="kpi-grid" aria-label="Resumen de repartidores">
  <% [["Repartidores registrados", @total, "En tu equipo", "violet", "users"], ["Repartidores activos", @active, "Con acceso habilitado", "good", "check-circle"], ["Repartidores inactivos", @inactive, "Sin acceso habilitado", "peach", "user"], ["Con repartos en curso", @assigned, "Asignados o en camino", "pink", "route"]].each do |label, value, caption, color, symbol| %>
    <article class="kpi"><span class="kpi-label"><%= label %></span><strong class="kpi-value"><%= value %></strong><span class="kpi-tag <%= color %>"><%= icon(symbol, "sm") %><%= caption %></span><span class="metric-art <%= color %>" aria-hidden="true"><%= icon(symbol) %></span></article>
  <% end %>
</section>
<%= turbo_frame_tag "directory", data: { turbo_action: "advance", controller: "filter", filter_url_value: autocomplete_drivers_path, action: "click@window->filter#outside turbo:before-frame-render->filter#rememberFocus turbo:frame-render->filter#restoreFocus" } do %>
  <section class="panel table-panel" aria-labelledby="driver-list-title">
    <div class="panel-heading">
      <div><h2 class="panel-title" id="driver-list-title">Listado de repartidores</h2><p class="panel-sub">Integrantes y contactos de tu empresa</p></div>
      <span class="result-count" role="status"><%= pluralize(@filtered_count, "repartidor", "repartidores") %></span>
    </div>
    <div class="toolbar">
      <%= form_with url: drivers_path, method: :get, class: "filters", data: { filter_target: "form", action: "submit->filter#cancel", turbo_frame: "directory", turbo_action: "advance" } do |form| %>
        <div class="customer-autocomplete" data-filter-target="autocomplete" data-action="focusout->filter#leave">
          <div class="field-search"><%= icon("search", "sm") %><%= form.search_field :q, value: @query, id: "driver-search", placeholder: "Buscar nombre, email o teléfono...", autocomplete: "off", maxlength: 120, role: "combobox", aria: { label: "Buscar repartidores", autocomplete: "list", controls: "driver-suggestions", expanded: "false" }, data: { filter_target: "query", action: "input->filter#search keydown->filter#navigate" } %></div>
          <ul id="driver-suggestions" class="customer-suggestions" role="listbox" aria-label="Repartidores sugeridos" data-filter-target="suggestions" hidden></ul>
          <span class="sr-only" role="status" data-filter-target="message"></span>
        </div>
        <%= form.select :status, [["Todos los estados", ""], ["Activos", "active"], ["Inactivos", "inactive"]], { selected: @status }, class: "select-filter", aria: { label: "Filtrar por estado" }, data: { action: "change->filter#submit" } %>
        <%= form.submit "Buscar", class: "btn btn-white btn-sm" %>
        <% if @query.present? || @status.present? %><%= link_to "Limpiar", drivers_path, class: "text-action" %><% end %>
      <% end %>
    </div>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Listado de repartidores, desplazamiento horizontal">
      <table class="data-table customers-table">
        <caption class="sr-only">Repartidores ordenados alfabéticamente por nombre</caption>
        <thead><tr><th scope="col" aria-sort="ascending">REPARTIDOR</th><th scope="col">EMAIL</th><th scope="col">TELÉFONO</th><th scope="col">REPARTOS</th><th scope="col">ESTADO</th><th scope="col"><span class="sr-only">Acciones</span></th></tr></thead>
        <tbody id="drivers"><%= render partial: "driver", collection: @drivers %></tbody>
      </table>
    </div>
    <% if @drivers.empty? %>
      <div class="empty">
        <span class="illustration"><%= icon("users", "lg") %></span>
        <h2><%= @total.zero? ? "Tu equipo empieza acá" : "No encontramos repartidores" %></h2>
        <p><%= @total.zero? ? "Agregá tu primer repartidor para empezar a asignarle repartos." : "Probá con otro nombre, email, teléfono o estado." %></p>
        <%= link_to "Nuevo repartidor", new_driver_path, class: "btn btn-dark btn-sm", data: { turbo_frame: "modal" } %>
      </div>
    <% end %>
    <nav class="table-footer" aria-label="Paginación de repartidores">
      <span>Página <%= @page %> de <%= @pages %> · Ordenados por nombre</span>
      <div class="pagination">
        <% if @page > 1 %><%= link_to "← Anterior", drivers_path(q: @query, status: @status, page: @page - 1), class: "btn btn-white btn-sm" %><% end %>
        <% if @page < @pages %><%= link_to "Siguiente →", drivers_path(q: @query, status: @status, page: @page + 1), class: "btn btn-white btn-sm" %><% end %>
      </div>
    </nav>
  </section>
<% end %>
