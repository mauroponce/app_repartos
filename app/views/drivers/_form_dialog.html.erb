<% title = driver.persisted? ? "Editar repartidor" : "Nuevo repartidor" %>
<% content_for :title, "#{title} · App Repartos" %>
<% content_for :modal_page, "true" %>
<%= turbo_frame_tag "modal", target: "_top" do %>
  <dialog class="customer-dialog" data-controller="modal" data-modal-return-url-value="<%= drivers_path %>" data-action="click->modal#backdrop close->modal#closed" aria-labelledby="driver-form-title">
    <div class="modal-title"><div><h1 id="driver-form-title"><%= title %></h1><p>Datos de contacto y acceso del repartidor.</p></div><%= link_to drivers_path, class: "icon-btn", aria: { label: "Cerrar formulario" }, data: { action: "modal#close" } do %><%= icon("close") %><% end %></div>
    <%= render "form", driver: driver %>
  </dialog>
<% end %>
