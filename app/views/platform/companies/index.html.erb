<div class="heading"><h1>Empresas registradas</h1><%= link_to "Crear empresa", new_platform_company_path, class: "btn btn-dark" %></div>
<ul><% @companies.each do |company| %><li><%= link_to company.name, platform_company_path(company) %> · <%= company.slug %> · <%= company.province %></li><% end %></ul>
<nav aria-label="Páginas"><%= link_to "Anterior", platform_companies_path(page: @page - 1) if @page > 1 %> <%= link_to "Siguiente", platform_companies_path(page: @page + 1) if @companies.size == 50 %></nav>
