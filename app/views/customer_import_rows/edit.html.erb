<div class="heading"><div><h1>Revisar fila <%= @row.number %></h1><p><%= @row.label %> · <%= @row.data["name"] %></p></div><%= link_to "Volver a resultados", customer_import_path(@customer_import), class: "btn btn-white" %></div>
<section class="management-panel"><h2>Datos originales</h2><p><%= @row.original.join(" · ") %></p><% (@row.issues + @row.warnings + @row.duplicates).each do |message| %><p><%= message %></p><% end %></section>
<% if @customer_import.editable? && @row.customer_id.nil? %>
  <%= form_with url: customer_import_row_path(@customer_import, @row), method: :patch, class: "management-panel field-grid", data: customer_location_data(@row).merge(turbo_frame: "_top") do |form| %>
    <% %w[name contact phone email external_code address city].each do |field| %><div class="field"><%= label_tag "row_#{field}", CustomerImports::Preparation::LABELS.fetch(field) %><%= text_field_tag "row[#{field}]", @row.data[field], maxlength: field == "name" ? 90 : 255, required: field.in?(%w[name address city]), data: { location_target: field.in?(%w[name address city]) ? field : nil } %></div><% end %>
    <div class="field"><%= label_tag :row_status, "Estado del cliente" %><%= select_tag "row[status]", options_for_select([["Activo", "active"], ["Inactivo", "inactive"]], @row.data["status"].presence || "active") %></div>
    <div class="field full"><h2>Revisar ubicación</h2><p>Elegí un candidato guardado, buscá otra dirección o corregí el punto con un clic o arrastrando el marcador.</p>
      <% @row.candidates.each do |candidate| %><div class="import-candidate"><p><strong><%= { "georef" => "Georef Argentina", "photon" => "Photon", "user" => "Archivo del usuario", "manual" => "Revisión manual" }.fetch(candidate["provider"], "Sin proveedor") %></strong> · <%= candidate["label"] %> · <%= { "interpolated" => "Interpolada", "address" => "Dirección con altura", "provided" => "Aportada por el usuario", "unknown" => "Precisión no informada" }.fetch(candidate["precision"], "Requiere revisión") %></p><p><%= Array(candidate["rejections"]).join(" · ") %></p><% if candidate["geographic_ambiguity"] %><p>El proveedor informa <%= candidate["city"] %> como ciudad y <%= candidate["sublocality"] %> como subdivisión. Revisá esta diferencia territorial.</p><% end %><% if Geocoding::Address.valid_point?(candidate["latitude"], candidate["longitude"], country: "Argentina") %><button type="button" class="btn btn-white" data-action="location#selectCandidate" data-latitude="<%= candidate["latitude"] %>" data-longitude="<%= candidate["longitude"] %>" data-address="<%= Geocoding::Address.query(candidate) %>" data-city="<%= candidate["city"] %>">Ver este candidato en el mapa</button><% else %><p>Sin coordenadas utilizables</p><% end %></div><% end %>
      <div class="location-search"><label for="customer-location-query">Buscar otra dirección</label><div class="location-search-row"><input id="customer-location-query" type="search" maxlength="255" autocomplete="off" role="combobox" aria-autocomplete="list" aria-controls="customer-location-results" aria-expanded="false" data-location-target="query" data-action="input->location#scheduleSearch keydown->location#keydown"><button type="button" class="btn btn-white" data-action="location#search">Buscar</button></div><ul id="customer-location-results" class="location-results" role="listbox" data-location-target="results" hidden></ul></div>
      <p data-location-target="searchMessage" role="status" aria-live="polite"></p><div class="customer-map" data-location-target="map" role="region" aria-label="Mapa para revisar ubicación"></div><p data-location-target="positionMessage" role="status" aria-live="polite">Las coordenadas sugeridas necesitan revisión.</p>
    </div>
    <div class="field"><%= label_tag :row_latitude, "Latitud" %><%= number_field_tag "row[latitude]", @row.latitude, step: "any", min: -90, max: 90, data: { location_target: "latitude", action: "input->location#coordinatesChanged" } %></div><div class="field"><%= label_tag :row_longitude, "Longitud" %><%= number_field_tag "row[longitude]", @row.longitude, step: "any", min: -180, max: 180, data: { location_target: "longitude", action: "input->location#coordinatesChanged" } %></div><input type="hidden" value="false" data-location-target="confirmed">
    <div class="field full"><label class="check-field"><%= check_box_tag :next, "1", true %> Continuar con la siguiente fila pendiente</label><div class="form-actions"><button type="submit" name="decision" value="manual" class="btn btn-dark">Confirmar manualmente la ubicación</button><button type="submit" name="decision" value="unlocated" class="btn btn-white">Guardar sin ubicación</button><button type="submit" name="decision" value="exclude" class="btn btn-white" formnovalidate>Omitir fila</button></div></div>
  <% end %>
<% else %><p>Este lote o cliente ya no admite cambios en la preparación.</p><% end %>
