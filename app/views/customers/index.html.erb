<% content_for :title, "Clientes · App Repartos" %>
<div class="breadcrumb"><span>Operación</span><%= icon("chevron") %><strong>Clientes</strong></div>
<div class="heading">
  <div><div class="eyebrow">Directorio</div><h1>Clientes</h1><p>Organizá tus comercios, sus contactos y direcciones para cada reparto.</p></div>
  <div class="heading-actions"><%= link_to "Importar clientes", new_customer_import_path, class: "btn btn-white" %><%= link_to new_customer_path, class: "btn btn-dark", data: { turbo_frame: "modal" } do %><%= icon("plus") %> Nuevo cliente<% end %></div>
</div>
<section class="kpi-grid" aria-label="Resumen de clientes">
  <% [["Clientes registrados", @total, "En el directorio", "violet", "store"], ["Clientes activos", @active, "Con servicio habilitado", "good", "check-circle"], ["Clientes inactivos", @inactive, "Sin servicio habilitado", "peach", "store"], ["Ciudades / zonas", @cities, "Cobertura de tus clientes", "pink", "pin"]].each do |label, value, caption, color, symbol| %>
    <article class="kpi"><span class="kpi-label"><%= label %></span><strong class="kpi-value"><%= value %></strong><span class="kpi-tag <%= color %>"><%= icon(symbol, "sm") %><%= caption %></span><span class="metric-art <%= color %>" aria-hidden="true"><%= icon(symbol) %></span></article>
  <% end %>
</section>
<div data-controller="product-filter">
  <section class="panel table-panel" aria-labelledby="customer-list-title">
    <div class="panel-heading">
      <div><h2 class="panel-title" id="customer-list-title">Listado de clientes</h2><p class="panel-sub">Comercios, contactos y direcciones de tu empresa</p></div>
    </div>
    <div class="toolbar">
      <%= form_with url: customers_path, method: :get, class: "filters", data: { turbo_frame: "directory", product_filter_target: "form" } do |form| %>
        <%= hidden_field_tag :sort, @sort, data: { product_filter_target: "sort" } %>
        <%= hidden_field_tag :direction, @direction, data: { product_filter_target: "direction" } %>
        <div class="field-search"><%= icon("search", "sm") %><%= form.search_field :q, value: @query, id: "customer-search", placeholder: "Buscar comercio, contacto o ciudad...", autocomplete: "off", maxlength: 120, aria: { label: "Buscar clientes" }, data: { product_filter_target: "query", action: "input->product-filter#search" } %></div>
        <%= form.select :status, [["Todos los estados", ""], ["Activos", "active"], ["Inactivos", "inactive"]], { selected: @status }, class: "select-filter product-status-filter", aria: { label: "Filtrar por estado" }, data: { action: "change->product-filter#submit" } %>
      <% end %>
    </div>
    <%= turbo_frame_tag "directory" do %>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Listado de clientes, desplazamiento horizontal">
      <table class="data-table customers-table">
        <caption class="sr-only">Listado de clientes</caption>
        <thead><tr><% customer_filters = { q: @query, status: @status || "" } %><% [["CLIENTE", "name"], ["CONTACTO", "contact"], ["DIRECCIÓN / CIUDAD", "address"], ["TELÉFONO", "phone"], ["ESTADO", "status"]].each do |label, column| %><%= sortable_column(label, column, method(:customers_path), customer_filters, frame: "directory") %><% end %><th scope="col"><span class="sr-only">Acciones</span></th></tr></thead>
        <tbody id="customers"><%= render @customers %></tbody>
      </table>
    </div>
    <% if @customers.empty? %>
      <div class="empty">
        <span class="illustration"><%= icon("store", "lg") %></span>
        <h2><%= @total.zero? ? "Tu directorio empieza acá" : "No encontramos clientes" %></h2>
        <p><%= @total.zero? ? "Agregá tu primer comercio y empezá a organizar tus repartos." : "Probá con otro nombre, ciudad o estado." %></p>
        <%= link_to "Nuevo cliente", new_customer_path, class: "btn btn-dark btn-sm", data: { turbo_frame: "modal" } %>
      </div>
    <% end %>
    <nav class="table-footer" aria-label="Paginación de clientes">
      <span role="status">Página <%= @page %> de <%= @pages %> · <%= pluralize(@filtered_count, "cliente", "clientes") %></span>
      <div class="pagination">
        <% if @page > 1 %><%= link_to "← Anterior", customers_path(q: @query, status: @status || "", sort: @sort, direction: @direction, page: @page - 1), class: "btn btn-white btn-sm" %><% end %>
        <% if @page < @pages %><%= link_to "Siguiente →", customers_path(q: @query, status: @status || "", sort: @sort, direction: @direction, page: @page + 1), class: "btn btn-white btn-sm" %><% end %>
      </div>
    </nav>
    <% end %>
  </section>
</div>
