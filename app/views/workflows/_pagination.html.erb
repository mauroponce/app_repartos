<nav class="table-footer" aria-label="Paginación"><span>Página <%= @page %> de <%= @pages %> · <%= @filtered_count %> registros</span><div class="pagination"><% if @page > 1 %><%= link_to "← Anterior", url_for(request.query_parameters.merge(page: @page - 1)), class: "btn btn-white" %><% end %><% if @page < @pages %><%= link_to "Siguiente →", url_for(request.query_parameters.merge(page: @page + 1)), class: "btn btn-white" %><% end %></div></nav>
