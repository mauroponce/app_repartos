<% records = events.to_a %>
<% user_ids = records.flat_map { |event| Array(event.changeset["assignee_id"]) + Array(event.changeset["assigned_to_id"]) }.compact %>
<% names = Current.company.users.where(id: user_ids).pluck(:id, :name).to_h %>
<% labels = { "status" => "Estado", "visit_status" => "Resultado de la visita", "assignee_id" => "Responsable de tarea", "assigned_to_id" => "Responsable de incidencia", "due_at" => "Vencimiento", "closed_at" => "Fecha de cierre", "resolved_at" => "Fecha de resolución", "priority" => "Prioridad", "category" => "Categoría", "title" => "Título", "description" => "Descripción", "resolution" => "Resolución", "result" => "Resultado" } %>
<ol class="workflow-timeline"><% records.each do |event| %><li><strong><%= workflow_date(event.created_at) %> · <%= event.user&.name || "Sistema" %></strong><p><%= event.message %></p>
<% changes = event.changeset.slice(*labels.keys) %>
<% if changes.present? || event.changeset["recovery_order_ids"].present? || event.changeset["task_id"].present? %><details><summary>Cambios registrados</summary><dl class="workflow-evidence"><% changes.each do |field, raw| %><dt><%= labels.fetch(field) %></dt><dd><%= workflow_change_value(field, raw, names) %></dd><% end %></dl><% Array(event.changeset["recovery_order_ids"]).each do |id| %><%= link_to "Pedido de recuperación ##{id}", delivery_order_path(id), class: "btn btn-white" %><% end %><% if event.changeset["task_id"] %><%= link_to "Ver tarea ##{event.changeset['task_id']}", workflow_task_path(event.changeset["task_id"]), class: "btn btn-white" %><% end %></details><% end %>
<% if event.commercial_opportunity_id && event.action.in?(%w[detected reopened]) %><details><summary>Evidencia al detectar la oportunidad</summary><dl class="workflow-evidence"><% event.changeset.except("order_ids", "customer_ids").each do |key, value| %><dt><%= workflow_evidence_label(key) %></dt><dd><%= workflow_evidence_value(key, value) %></dd><% end %></dl><% Array(event.changeset["order_ids"]).each do |id| %><%= link_to "Pedido ##{id}", delivery_order_path(id), class: "btn btn-white" %><% end %></details><% end %>
<% if event.changeset["items"].present? %><details><summary>Mercadería al registrar el resultado</summary><% event.changeset["items"].each do |item| %><p><%= item["description"] %>: <%= quantity_text(item["delivered_quantity"]) %> / <%= quantity_text(item["planned_quantity"]) %> <%= quantity_unit(item["unit"], item["planned_quantity"]) %></p><% end %></details><% end %>
</li><% end %></ol><% if records.empty? %><p class="empty-state">Todavía no hay acciones registradas.</p><% end %>
