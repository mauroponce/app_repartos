<section class="management-panel"><h2>Reporte original</h2><p><strong><%= Incident::KINDS.fetch(incident.kind) %></strong> · <%= Incident::PRIORITIES.fetch(incident.priority) %> · <%= workflow_badge(incident) %></p><p><%= incident.description %></p><p>Reportado por <%= incident.reporter&.name || "Autor desconocido" %> · <%= workflow_date(incident.occurred_at) %></p><p><%= incident.context["customer_name"] %><br><%= incident.context["customer_address"] %></p>
<% items = incident.context["items"] || [] %><% if items.any? %><div class="table-scroll"><table class="data-table"><thead><tr><th>Producto</th><th>Unidad</th><th>Planificado</th><th>Entregado al reportar</th></tr></thead><tbody><% items.each do |item| %><tr><td><%= item["description"] %></td><td><%= DeliveryUnits::LABELS[item["unit"]] %></td><td><%= quantity_text(item["planned_quantity"]) %></td><td><%= quantity_text(item["delivered_quantity"]) %></td></tr><% end %></tbody></table></div><% end %>
<div class="evidence-gallery"><% incident.incident_photos.each do |photo| %><% if photo.file.attached? && !photo.purged_at %><%= link_to incident_photo_path(photo), target: "_blank", rel: "noopener" do %><%= image_tag incident_photo_path(photo), alt: "Fotografía de la incidencia #{incident.id}", loading: "lazy" %><% end %><% end %><% end %></div>
</section>
