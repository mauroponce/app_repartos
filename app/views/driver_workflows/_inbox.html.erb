<% notices = inbox.notices(local_assigns[:page] || 1) %><% task_page = local_assigns[:tasks_page] || 1 %><% incident_page = local_assigns[:incidents_page] || 1 %><% tasks = inbox.tasks(task_page) %><% incidents = inbox.incidents(incident_page) %><% authorized_incident_ids = Incident.visible_to_driver(inbox.user).where(id: tasks.map(&:incident_id)).pluck(:id) %>
<div class="driver-inbox-head"><h3>Avisos de administración</h3><p>La lectura y ejecución se confirman al sincronizar con el servidor.</p></div>
<% if notices.empty? %><p class="empty-state">No hay avisos para mostrar.</p><% end %>
<% notices.each do |notice| %><article class="driver-workflow-card" data-notice-id="<%= notice.id %>"><h3><%= notice.title %></h3><p><%= notice.body %></p><small><%= workflow_date(notice.created_at) %></small><p><%= notice.read_at ? "Leído el #{workflow_date(notice.read_at)}" : "Pendiente de lectura" %><%= " · Ejecución confirmada" if notice.acknowledged_at %></p><% unless notice.read_at %><form data-workflow-form data-command="notice_read" data-action="submit->driver-workflow#submit"><input type="hidden" name="id" value="<%= notice.id %>"><button type="submit" class="btn btn-secondary">Marcar como leído</button><p role="status" data-workflow-message></p></form><% end %></article><% end %>
<nav class="driver-inbox-pages"><% current = local_assigns[:page] || 1 %><% if current > 1 %><button type="button" data-action="driver-workflow#page" data-page="<%= current - 1 %>">← Más recientes</button><% end %><% if notices.size == 20 %><button type="button" data-action="driver-workflow#page" data-page="<%= current + 1 %>">Más antiguos →</button><% end %></nav>
<h3>Tareas operativas pendientes</h3><% if tasks.empty? %><p class="empty-state">No tenés tareas operativas pendientes.</p><% end %>
<% tasks.each do |task| %><article class="driver-workflow-card" data-task-id="<%= task.id %>"><h3><%= task.title %></h3><p><%= task.description %></p><p><%= workflow_badge(task) %> · <%= Incident::PRIORITIES.fetch(task.priority) %><br>Vence: <%= workflow_date(task.due_at) %></p>
<% if task.status == "pending" %><form data-workflow-form data-command="task_start" data-action="submit->driver-workflow#submit"><input type="hidden" name="id" value="<%= task.id %>"><input type="hidden" name="version" value="<%= task.lock_version %>"><button type="submit" class="btn btn-secondary">Iniciar tarea</button><p role="status" data-workflow-message></p></form><% end %>
<form data-workflow-form data-command="task_complete" data-action="submit->driver-workflow#submit"><input type="hidden" name="id" value="<%= task.id %>"><input type="hidden" name="version" value="<%= task.lock_version %>"><label>Resultado de la instrucción<textarea name="result" required maxlength="4000" rows="2" placeholder="Registrá qué hiciste y el resultado."></textarea></label><button type="submit" class="btn btn-secondary">Confirmar ejecución</button><p role="status" data-workflow-message></p></form>
<% if task.incident_id && authorized_incident_ids.include?(task.incident_id) %><button type="button" class="text-link" data-action="driver-workflow#incident" data-id="<%= task.incident_id %>">Ver incidencia relacionada</button><% end %></article><% end %>
<nav class="driver-inbox-pages"><% if task_page > 1 %><button type="button" data-action="driver-workflow#page" data-page-scope="tasks" data-page="<%= task_page - 1 %>">← Tareas anteriores</button><% end %><% if tasks.size == 30 %><button type="button" data-action="driver-workflow#page" data-page-scope="tasks" data-page="<%= task_page + 1 %>">Más tareas →</button><% end %></nav>
<h3>Mis incidencias</h3><% if incidents.empty? %><p>No informaste incidencias todavía.</p><% end %><% incidents.each do |incident| %><button type="button" class="driver-workflow-card driver-incident-link" data-action="driver-workflow#incident" data-id="<%= incident.id %>"><strong>#<%= incident.id %> · <%= Incident::KINDS.fetch(incident.kind) %></strong><span><%= Incident::STATUSES.fetch(incident.status) %> · <%= workflow_date(incident.occurred_at) %></span></button><% end %>

<nav class="driver-inbox-pages"><% if incident_page > 1 %><button type="button" data-action="driver-workflow#page" data-page-scope="incidents" data-page="<%= incident_page - 1 %>">← Más recientes</button><% end %><% if incidents.size == 20 %><button type="button" data-action="driver-workflow#page" data-page-scope="incidents" data-page="<%= incident_page + 1 %>">Más incidencias →</button><% end %></nav>
