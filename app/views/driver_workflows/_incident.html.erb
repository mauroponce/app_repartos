<h2>Incidencia #<%= incident.id %></h2><%= render "workflows/incident_context", incident: incident %>
<h3>Decisiones e información</h3><% incident.workflow_events.includes(:user).order(:id).each do |event| %><article class="driver-workflow-card"><strong><%= event.user&.name || "Sistema" %> · <%= workflow_date(event.created_at) %></strong><p><%= event.message %></p></article><% end %>
<% unless incident.terminal? %><form data-workflow-form data-command="incident_information" data-action="submit->driver-workflow#submit"><input type="hidden" name="id" value="<%= incident.id %>"><label>Información adicional para administración<textarea name="message" required maxlength="4000" rows="3"></textarea></label><button type="submit" class="btn btn-secondary">Enviar información</button><p role="status" data-workflow-message></p></form><% end %>
