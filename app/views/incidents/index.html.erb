<% content_for :title, "Incidencias · App Repartos" %>
<div class="heading"><div><div class="eyebrow">Comunicación interna</div><h1>Incidencias</h1><p>Problemas de la jornada, decisiones y seguimientos trazables.</p></div><%= link_to "Ver tareas", workflow_tasks_path, class: "btn btn-white" %></div>
<%= render "workflows/live" %>
<%= form_with url: incidents_path, method: :get, class: "workflow-filters" do |f| %>
  <div class="field"><%= f.label :start_on, "Desde" %><%= f.date_field :start_on, value: params[:start_on] %></div><div class="field"><%= f.label :end_on, "Hasta" %><%= f.date_field :end_on, value: params[:end_on] %></div>
  <% { kind: ["Tipo", Incident::KINDS], priority: ["Prioridad", Incident::PRIORITIES], status: ["Estado", Incident::STATUSES.merge("overdue" => "Vencidas")] }.each do |key, (label, options)| %><div class="field"><%= f.label key, label %><%= f.select key, options.map { |value, text| [text, value] }, { include_blank: "Todos", selected: params[key] } %></div><% end %>
  <% { driver_id: ["Repartidor", @staff.select(&:driver?)], assigned_to_id: ["Responsable", @staff.select(&:manages_customers?)], customer_id: ["Cliente", @customers], delivery_run_id: ["Ruta", @runs] }.each do |key, (label, options)| %><div class="field"><%= f.label key, label %><%= f.collection_select key, options, :id, :name, { include_blank: "Todos", selected: params[key] }, data: workflow_select_data(key) %></div><% end %><%= f.submit "Filtrar", class: "btn btn-dark" %><%= link_to "Limpiar", incidents_path, class: "text-action" %>
<% end %>
<div id="workflow-results">
  <div class="report-kpis"><% Incident::STATUSES.each do |key, label| %><%= link_to incidents_path(status: key), class: "report-kpi" do %><span><%= label %></span><strong><%= @counts.fetch(key, 0) %></strong><% end %><% end %><%= link_to incidents_path(status: "overdue"), class: "report-kpi" do %><span>Vencidas</span><strong><%= @overdue %></strong><% end %></div>
  <section class="management-panel"><div class="table-scroll"><table class="data-table"><thead><tr><th>Incidencia</th><th>Contexto</th><th>Prioridad / estado</th><th>Responsable</th><th>Fecha / vence</th></tr></thead><tbody>
    <% @incidents.each do |incident| %><tr><td><%= link_to "##{incident.id} · #{Incident::KINDS.fetch(incident.kind)}", incident_path(incident), class: "text-action" %></td><td><%= incident.customer&.name || "Sin cliente" %><br><%= incident.driver&.name || "Autoría de reparto desconocida" %><br><%= incident.delivery_run&.name %></td><td><%= Incident::PRIORITIES.fetch(incident.priority) %><br><%= workflow_badge(incident) %><%= " · Vencida" if incident.overdue? %></td><td><%= incident.assigned_to&.name || "Sin asignar" %></td><td><%= workflow_date(incident.occurred_at) %><br><%= workflow_date(incident.due_at) if incident.due_at %></td></tr><% end %>
  </tbody></table></div><% if @incidents.empty? %><div class="empty"><h2>No hay incidencias para estos filtros</h2><p>Los reportes de los repartidores y los resultados problemáticos de las visitas aparecerán acá.</p></div><% end %><%= render "workflows/pagination" %></section>
</div>
