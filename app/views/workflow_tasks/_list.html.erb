<div class="table-scroll"><table class="data-table"><thead><tr><th>Tarea</th><th>Categoría / prioridad</th><th>Responsable</th><th>Estado / vencimiento</th></tr></thead><tbody><% tasks.each do |task| %><tr><td><%= link_to task.title, workflow_task_path(task), class: "text-action" %><br><%= task.customer&.name %></td><td><%= WorkflowTask::CATEGORIES.fetch(task.category) %> · <%= Incident::PRIORITIES.fetch(task.priority) %></td><td><%= task.assignee&.name || "Sin asignar" %></td><td><%= workflow_badge(task) %><br><%= workflow_date(task.due_at) %><%= " · Vencida" if !task.terminal? && task.due_at && task.due_at < Time.current %></td></tr><% end %></tbody></table></div><% if tasks.empty? %><p class="empty-state">No hay tareas para mostrar.</p><% end %>
