<% content_for :title, "Tareas · App Repartos" %>
<div class="heading"><div><div class="eyebrow">Trabajo compartido</div><h1>Tareas</h1><p>Seguimientos operativos, comerciales y administrativos.</p></div><%= link_to "Nueva tarea", new_workflow_task_path, class: "btn btn-dark" %></div><%= render "workflows/live" %>
<%= form_with url: workflow_tasks_path, method: :get, class: "workflow-filters" do |f| %>
<% { category: ["Categoría", WorkflowTask::CATEGORIES], status: ["Estado", WorkflowTask::STATUSES], priority: ["Prioridad", Incident::PRIORITIES] }.each do |key, (label, options)| %><div class="field"><%= f.label key, label %><%= f.select key, options.map { |value, text| [text, value] }, include_blank: "Todas", selected: params[key] %></div><% end %>
<div class="field"><%= f.label :assignee_id, "Responsable" %><%= f.collection_select :assignee_id, @staff, :id, :name, { include_blank: "Todos", selected: params[:assignee_id] }, data: workflow_select_data(:assignee_id) %></div><div class="field"><%= f.label :customer_id, "Cliente" %><%= f.collection_select :customer_id, @customers, :id, :name, { include_blank: "Todos", selected: params[:customer_id] }, data: workflow_select_data(:customer_id) %></div><div class="field"><%= f.label :overdue, "Vencimiento" %><%= f.select :overdue, [["Todas", ""], ["Solo vencidas", "1"]], selected: params[:overdue] %></div><%= f.submit "Filtrar", class: "btn btn-dark" %><% end %>
<div id="workflow-results"><% if @notices.any? %><section class="management-panel"><h2>Avisos internos pendientes</h2><% @notices.each do |notice| %><article class="workflow-notice"><strong><%= notice.title %></strong><p><%= notice.body %></p><%= button_to "Marcar como leído", read_internal_notice_path(notice), params: { operation_id: SecureRandom.uuid }, class: "btn btn-white" %></article><% end %></section><% end %><section class="management-panel"><%= render "workflow_tasks/list", tasks: @tasks %><%= render "workflows/pagination" %></section></div>
