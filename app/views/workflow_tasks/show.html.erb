<% content_for :title, @task.title %><div class="heading"><div><div class="eyebrow">Tarea #<%= @task.id %></div><h1><%= @task.title %></h1></div><%= link_to "Volver a tareas", workflow_tasks_path, class: "btn btn-white" %></div><%= render "workflows/live" %>
<div id="workflow-results"><section class="management-panel"><h2>Instrucción y contexto</h2><p><%= @task.description %></p><p><%= WorkflowTask::CATEGORIES.fetch(@task.category) %> · <%= Incident::PRIORITIES.fetch(@task.priority) %> · <%= workflow_badge(@task) %></p><p>Creada por <%= @task.creator&.name || "Regla automática" %> · Responsable: <%= @task.assignee&.name || "Sin asignar" %> · Vence: <%= workflow_date(@task.due_at) %></p>
<% if @task.customer %><%= link_to "Ver cliente", customer_path(@task.customer), class: "btn btn-white" %><% end %><% if @task.incident %><%= link_to "Ver incidencia", incident_path(@task.incident), class: "btn btn-white" %><% end %><% if @task.delivery_order %><%= link_to "Ver pedido", delivery_order_path(@task.delivery_order), class: "btn btn-white" %><% end %><% if @task.commercial_opportunity %><%= link_to "Ver oportunidad", commercial_opportunity_path(@task.commercial_opportunity), class: "btn btn-white" %><% end %>
<% if @task.terminal? %><h3>Resultado</h3><p><%= @task.result %></p><p>Cerrada: <%= workflow_date(@task.closed_at) %></p><% else %>
<%= form_with url: workflow_task_path(@task), method: :patch, scope: :task, class: "field-grid management-form" do |f| %><%= hidden_field_tag :operation_id, SecureRandom.uuid %><%= f.hidden_field :version, value: @task.lock_version %>
<div class="field"><%= f.label :action, "Acción" %><%= f.select :action, [["Actualizar / reasignar", "update"], ["Iniciar", "start"], ["Completar", "complete"], ["Cancelar con motivo", "cancel"]] %></div><div class="field"><%= f.label :assignee_id, "Responsable" %><%= f.collection_select :assignee_id, @staff, :id, :name, include_blank: "Sin asignar", selected: @task.assignee_id %></div><div class="field"><%= f.label :priority, "Prioridad" %><%= f.select :priority, Incident::PRIORITIES.map { |key, label| [label, key] }, selected: @task.priority %></div><div class="field"><%= f.label :due_at, "Vencimiento" %><%= f.datetime_local_field :due_at, value: @task.due_at&.in_time_zone(Current.company.time_zone)&.strftime("%Y-%m-%dT%H:%M") %></div><div class="field full"><%= f.label :result, "Resultado / observaciones (obligatorio para cerrar)" %><%= f.text_area :result, rows: 3, maxlength: 4000 %></div><div class="form-actions full"><%= f.submit "Guardar acción", class: "btn btn-dark" %></div><% end %><% end %></section><section class="management-panel"><h2>Historial de cambios</h2><%= render "workflows/history", events: @events %></section></div>
