<% content_for :title, "Nueva tarea" %><div class="heading"><h1>Nueva tarea</h1><%= link_to "Volver", workflow_tasks_path, class: "btn btn-white" %></div>
<section class="management-panel"><%= form_with url: workflow_tasks_path, scope: :task, class: "field-grid management-form" do |f| %><%= hidden_field_tag :operation_id, SecureRandom.uuid %>
<div class="field full"><%= f.label :title, "Título *" %><%= f.text_field :title, required: true, maxlength: 255 %></div><div class="field full"><%= f.label :description, "Descripción e instrucciones" %><%= f.text_area :description, maxlength: 4000, rows: 3 %></div>
<div class="field"><%= f.label :category, "Categoría" %><%= f.select :category, WorkflowTask::CATEGORIES.map { |key, value| [value, key] }, selected: "administrative" %></div><div class="field"><%= f.label :priority, "Prioridad" %><%= f.select :priority, Incident::PRIORITIES.map { |key, value| [value, key] }, selected: "normal" %></div>
<div class="field"><%= f.label :assignee_id, "Responsable" %><%= f.collection_select :assignee_id, @staff, :id, :name, include_blank: "Sin asignar" %></div><div class="field"><%= f.label :due_at, "Vencimiento" %><%= f.datetime_local_field :due_at %></div><div class="field"><%= f.label :customer_id, "Cliente relacionado" %><%= f.collection_select :customer_id, @customers, :id, :name, { include_blank: "Sin cliente" }, data: workflow_select_data(:customer_id) %></div><div class="field"><%= f.label :delivery_run_id, "Ruta relacionada" %><%= f.collection_select :delivery_run_id, @runs, :id, :name, { include_blank: "Sin ruta" }, data: workflow_select_data(:delivery_run_id) %></div><div class="form-actions full"><%= f.submit "Crear tarea", class: "btn btn-dark" %></div><% end %><p class="hint">Las tareas comerciales y administrativas solo son visibles en administración. Para un repartidor elegí una tarea operativa.</p></section>
