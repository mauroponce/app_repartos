<% content_for :title, "Propuesta de ruta · App Repartos" %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<% status = @expired ? "expired" : @proposal.status %>
<div class="heading"><div><div class="eyebrow">Vista previa de optimización</div><h1><%= @run.name %></h1><p>Solicitada por <%= @proposal.requested_by.name %> · <%= l(@proposal.created_at, format: :short) %></p></div><%= link_to "Volver a la hoja", delivery_run_path(@run), class: "btn btn-white" %></div>
<section class="management-panel" data-controller="route-optimization" data-route-optimization-poll-url-value="<%= delivery_run_optimization_proposal_path(@run, @proposal, format: :json) %>" data-route-optimization-pending-value="<%= status.in?(%w[queued processing]) %>">
<p role="status" data-route-optimization-target="status"><%= {"queued" => "Cálculo en cola. Podés salir y volver a esta pantalla.", "processing" => "Calculando tiempos por calles y evaluando el orden…", "ready" => "Propuesta lista para revisar.", "failed" => "No se pudo calcular la propuesta.", "expired" => "Esta propuesta caducó. Solicitá un cálculo nuevo.", "discarded" => "Propuesta descartada; se conservó el orden anterior.", "applied" => "Propuesta aplicada a la hoja de ruta."}.fetch(status) %></p>
<% if @proposal.error_message.present? %><p class="form-error"><%= @proposal.error_message %></p><% end %>
<% result = @proposal.result %>
<% if result.present? %>
<p><%= result["origin"] == "open" ? "Recorrido abierto: no incluye traslado al primer cliente." : "Salida desde el depósito." %> <%= "Incluye regreso al depósito." if result["return_to_depot"] %> Horarios locales de <%= Current.company.time_zone %>.</p>
<div class="report-columns"><% {"original" => "Ruta actual al solicitar", "proposed" => "Ruta propuesta"}.each do |key, title| %><% metrics = result.fetch(key) %><article class="management-panel"><h2><%= title %></h2><p><strong><%= number_with_precision(metrics["distance"].to_f / 1000, precision: 1) %> km</strong> · <%= metrics["visit_ids"].size %> paradas</p><dl class="route-metrics"><dt>Conducción</dt><dd><%= route_duration(metrics["driving"]) %></dd><dt>Atención</dt><dd><%= route_duration(metrics["service"]) %></dd><dt>Espera</dt><dd><%= route_duration(metrics["waiting"]) %></dd><dt>Total estimado</dt><dd><%= route_duration(metrics["total"]) %></dd><dt>Restricciones incumplidas</dt><dd><%= metrics["violations"] %></dd></dl><% unless metrics["feasible"] %><p class="form-error">Recorrido no viable: hay ventanas incumplidas o conexiones viales inexistentes. Estas métricas son parciales; no representan un recorrido válido.</p><% end %></article><% end %></div>
<% proposed = result.fetch("proposed") %><% original = result.fetch("original") %>
<% if proposed["feasible"] && original["feasible"] %><p class="route-savings"><strong>Diferencia estimada:</strong> <%= number_with_precision(result["savings_distance"].to_f / 1000, precision: 1) %> km (<%= route_savings_percent(result["savings_distance"], original["distance"]) %>) y <%= route_duration(result["savings_driving"]) %> de conducción (<%= route_savings_percent(result["savings_driving"], original["driving"]) %>). Los valores negativos indican un aumento para respetar horarios o preferencias.</p><% end %>
<p><% if !proposed["feasible"] %>No se encontró un recorrido viable. Revisá las ventanas, la hora de salida y las conexiones entre paradas.<% elsif result["improved"] %>Se encontró una mejora según el criterio de evaluación.<% else %>Se recomienda conservar el orden actual: no se encontró una mejora válida.<% end %> <%= result["algorithm"] == "exact" ? "Búsqueda exacta para esta hoja pequeña." : "Resultado heurístico; no garantiza el óptimo global." %></p>
<% if proposed["geometry"] %><div class="route-preview-map" role="img" aria-label="Recorrido por calles de la propuesta" data-controller="route-preview" data-route-preview-geometry-value="<%= proposed['geometry'].to_json %>" data-route-preview-stops-value="<%= proposed['stops'].filter_map { |stop| visit = @visits[stop['id']]; { id: stop['id'], name: visit.customer_name, coordinates: [visit.customer.longitude.to_f, visit.customer.latitude.to_f] } if visit }.to_json %>"></div><p class="hint">Recorrido vial con datos de <a href="https://www.openstreetmap.org/copyright" rel="noopener" target="_blank">OpenStreetMap © colaboradores</a>. Vista sin teselas externas.</p><% end %>
<h2>Orden propuesto y horarios estimados</h2><ol class="planning-stops"><% proposed["stops"].each_with_index do |stop, index| %><% visit = @visits[stop["id"]] %><li class="planning-stop"><div><strong><%= index + 1 %>. <%= visit&.customer_name || "Parada retirada de la hoja" %></strong><p><%= visit&.customer_address %></p><p>Llegada: <%= route_clock(@run, stop["arrival"]) %> · Atención: <%= route_clock(@run, stop["service_start"]) %>–<%= route_clock(@run, stop["finish"]) %> · Espera: <%= route_duration(stop["waiting"]) %></p><% if stop["late"].positive? %><p class="form-error">Ventana incumplida por <%= route_duration(stop["late"]) %></p><% end %></div></li><% end %></ol>
<details><summary>Criterio de evaluación</summary><p>Primero se minimizan restricciones obligatorias incumplidas. Entre recorridos viables se minimiza duración total más dos segundos de penalización por segundo fuera de la tolerancia del horario preferido (<%= result["preferred_tolerance"] %> minutos). Conducción y distancia desempatan. Los tiempos no incluyen tránsito en vivo, cortes recientes ni variaciones de descarga.</p></details>
<% end %>
<div class="form-actions route-proposal-actions">
<% if status == "ready" && result.dig("proposed", "feasible") %><%= button_to "Confirmar orden propuesto", apply_delivery_run_optimization_proposal_path(@run, @proposal), class: "btn btn-dark", data: { turbo_confirm: "¿Aplicar este orden? Se conservan pedidos, cantidades y estados." } %><% end %>
<% unless status.in?(%w[applied discarded]) %><%= button_to "Descartar propuesta", delivery_run_optimization_proposal_path(@run, @proposal), method: :delete, class: "btn btn-white" %><% end %>
<% if !status.in?(%w[queued processing]) && @run.editable? %><%= link_to "Solicitar nuevo cálculo", new_delivery_run_optimization_proposal_path(@run), class: "text-action" %><% end %>
</div>
</section>
