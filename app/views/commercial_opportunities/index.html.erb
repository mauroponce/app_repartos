<% content_for :title, "Oportunidades comerciales" %><div class="heading"><h1>Oportunidades comerciales</h1><%= link_to "Volver a reportes", reports_path, class: "btn btn-white" %></div><%= render "workflows/live" %><%= form_with url: commercial_opportunities_path, method: :get, class: "workflow-filters" do |f| %><div class="field"><%= f.label :status, "Estado" %><%= f.select :status, CommercialOpportunity::STATUSES.map { |key, label| [label, key] }, include_blank: "Todos", selected: params[:status] %></div><div class="field"><%= f.label :rule, "Tipo de oportunidad" %><%= f.select :rule, CommercialOpportunity::RULES.map { |key, label| [label, key] }, include_blank: "Todos", selected: params[:rule] %></div><%= f.submit "Filtrar", class: "btn btn-dark" %><% end %><section class="management-panel" id="workflow-results"><%= render "commercial_opportunities/list", opportunities: @opportunities %><%= render "workflows/pagination" %></section>
