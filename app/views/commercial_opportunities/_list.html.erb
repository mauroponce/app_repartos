<% if opportunities.empty? %><div class="empty"><h3>No hay oportunidades para estos filtros</h3><p>Las reglas usan datos reales. Podés solicitar una evaluación o revisar sus umbrales.</p></div><% end %><div class="workflow-cards"><% opportunities.each do |opportunity| %><article class="workflow-card"><div class="eyebrow"><%= CommercialOpportunity::RULES.fetch(opportunity.rule) %></div><h3><%= link_to opportunity.title, commercial_opportunity_path(opportunity), class: "text-action" %></h3><%= workflow_badge(opportunity) %><p>Detectada: <%= workflow_date(opportunity.detected_at) %><br>Evaluada: <%= workflow_date(opportunity.last_evaluated_at) %></p><%= link_to "Ver evidencia y actuar", commercial_opportunity_path(opportunity), class: "btn btn-white" %></article><% end %></div>
