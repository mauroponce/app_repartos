<% content_for :title, @opportunity.title %><div class="heading"><div><div class="eyebrow"><%= CommercialOpportunity::RULES.fetch(@opportunity.rule) %></div><h1><%= @opportunity.title %></h1></div><%= link_to "Volver a reportes", reports_path, class: "btn btn-white" %></div><%= render "workflows/live" %><div id="workflow-results">
<section class="management-panel"><h2>Evidencia de la detección</h2><p><%= workflow_badge(@opportunity) %> · Detectada <%= workflow_date(@opportunity.detected_at) %> · Última evaluación <%= workflow_date(@opportunity.last_evaluated_at) %></p><dl class="workflow-evidence"><% @opportunity.evidence.except("customer_ids", "order_ids").each do |key, value| %><dt><%= workflow_evidence_label(key) %></dt><dd><%= workflow_evidence_value(key, value) %></dd><% end %></dl><% if @opportunity.customer %><%= link_to "Ver cliente", customer_path(@opportunity.customer), class: "btn btn-white" %><%= link_to "Ver pedidos del cliente", reports_path(customer_id: @opportunity.customer_id, period: 90, anchor: "report-orders"), class: "btn btn-white" %><% end %><% if @opportunity.product %><%= link_to "Ver pedidos del producto", reports_path(product_id: @opportunity.product_id, period: 90, anchor: "report-orders"), class: "btn btn-white" %><% end %><% if @opportunity.resolution.present? %><h3>Última gestión</h3><p><%= @opportunity.resolution %></p><% end %></section>
<% if @orders.any? || @affected_customers.any? %><section class="management-panel"><h2>Registros relacionados</h2><% @affected_customers.each do |customer| %><%= link_to customer.name, customer_path(customer), class: "btn btn-white" %><% end %><% @orders.each do |order| %><%= link_to "Pedido ##{order.id} · #{l(order.scheduled_date)}", delivery_order_path(order), class: "btn btn-white" %><% end %><p class="hint">La evidencia conserva una muestra de hasta 50 pedidos y 30 clientes; los totales corresponden al conjunto completo.</p></section><% end %>
<section class="management-panel"><h2>Actuar sobre la oportunidad</h2><%= form_with url: act_commercial_opportunity_path(@opportunity), class: "field-grid management-form" do |f| %><%= hidden_field_tag :operation_id, SecureRandom.uuid %><%= hidden_field_tag "opportunity[version]", @opportunity.lock_version %><div class="field"><%= label_tag "opportunity_action", "Acción" %><%= select_tag "opportunity[action]", options_for_select([["Crear o abrir tarea comercial", "task"], ["Marcar como gestionada", "managed"], ["Posponer", "snoozed"], ["Descartar con motivo", "dismissed"]]) %></div><div class="field"><%= label_tag "opportunity_assignee_id", "Responsable de la tarea" %><%= select_tag "opportunity[assignee_id]", options_from_collection_for_select(@staff.select(&:manages_customers?), :id, :name), include_blank: "Sin asignar" %></div><div class="field"><%= label_tag "opportunity_due_at", "Vencimiento de la tarea" %><%= datetime_local_field_tag "opportunity[due_at]" %></div><div class="field"><%= label_tag "opportunity_snoozed_until", "Retomar el análisis el" %><%= datetime_local_field_tag "opportunity[snoozed_until]" %></div><div class="field full"><%= label_tag "opportunity_message", "Instrucción o motivo *" %><%= text_area_tag "opportunity[message]", nil, required: true, rows: 3, maxlength: 4000 %></div><div class="form-actions full"><%= f.submit "Registrar gestión", class: "btn btn-dark" %></div><% end %></section>
<section class="management-panel"><h2>Tareas vinculadas</h2><%= render "workflow_tasks/list", tasks: @tasks %></section><section class="management-panel"><h2>Historial</h2><%= render "workflows/history", events: @events %></section></div>
