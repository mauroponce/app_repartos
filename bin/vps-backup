#!/usr/bin/env bash
# Only ciphertext leaves this VPS. Recovery identities never belong here.
set -euo pipefail
script_root="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
# shellcheck source=../lib/backup/common.sh
source "$script_root/lib/backup/common.sh"
backup_init backup
backup_lock
[[ -z "${BACKUP_REMOTE:-}" ]] || { echo 'BACKUP_REMOTE/rsync fue retirado. Configurá BACKUP_RCLONE_REMOTE cifrado.' >&2; exit 1; }
if [[ "${BACKUP_LOCAL_ONLY:-0}" != 1 ]]; then backup_require_remote; fi
backup_work="$(mktemp -d "$backup_root/.creating-XXXXXX")"
backup_cleanup_paths+=("$backup_work")
backup_id="backup-$(date -u +%Y%m%dT%H%M%SZ)-$(python3 -c 'import secrets; print(secrets.token_hex(6))').tar.age"
backup_target="$backup_root/$backup_id"
backup_capture "$backup_work" "$backup_target"
backup_external=false
if [[ "${BACKUP_LOCAL_ONLY:-0}" != 1 ]]; then
  backup_stage="upload"
  rclone copyto "$backup_target" "${backup_remote%/}/$backup_id" --immutable --quiet
  backup_stage="remote-integrity"
  backup_local_hash="$(sha256sum "$backup_target" | cut -d' ' -f1)"
  backup_remote_hash="$(rclone cat "${backup_remote%/}/$backup_id" | sha256sum | cut -d' ' -f1)"
  [[ "$backup_local_hash" == "$backup_remote_hash" ]] || { echo 'La copia remota no coincide con el archivo cifrado local' >&2; exit 1; }
  backup_stage="remote-retention"
  rclone delete "$backup_remote" --min-age "${backup_remote_days}d" --include 'backup-*.tar.age' --max-depth 1 --quiet
  backup_external=true
fi
backup_stage="local-retention"
mapfile -t backups < <(find "$backup_root" -maxdepth 1 -type f -name 'backup-*.tar.age' | sort -r)
for ((index=backup_keep; index<${#backups[@]}; index++)); do rm -- "${backups[index]}"; done
backup_stage="complete"
backup_write_state ok "$backup_external" "$backup_target"
if [[ "$backup_external" == true ]]; then echo "Backup externo cifrado y verificado: $backup_id"; else echo "Backup local cifrado: $backup_id. NO se realizó copia externa."; fi
