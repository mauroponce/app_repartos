#!/usr/bin/env ruby
require "bundler/setup"
require "kamal"
require "pathname"
# These values validate structure only and cannot be mistaken for a target VPS.
ENV["DEPLOY_HOST"] ||= "127.0.0.1"
ENV["APP_HOST"] ||= "deployment.invalid"
ENV["DEPLOY_SSH_USER"] ||= "DEPLOY_USER_PLACEHOLDER"
config = Kamal::Configuration.create_from(config_file: Pathname.new(File.expand_path("../config/deploy.yml", __dir__)), version: "configuration-validation")
raise "La base no debe publicar puertos" if config.accessory("db").port
raise "OSRM no debe publicar puertos" if config.accessory("osrm").port
raise "El registry debe ser local" unless config.registry.server == "localhost:5555"
puts "Configuración validada por Kamal #{Kamal::VERSION}. No se abrió ninguna conexión ni se imprimieron secretos."
