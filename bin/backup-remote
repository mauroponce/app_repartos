#!/usr/bin/env bash
set -euo pipefail
script_root="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"
# shellcheck source=../lib/backup/common.sh
source "$script_root/lib/backup/common.sh"
backup_init remote
backup_stage="remote"
case "${1:-}" in
  list) backup_require_remote; rclone lsf "$backup_remote" --files-only --max-depth 1 --include 'backup-*.tar.age' ;;
  fetch)
    backup_require_remote
    name="${2:?Indicá el nombre elegido al listar}"
    [[ "$name" =~ ^backup-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{12}\.tar\.age$ ]] || { echo 'Nombre de backup remoto inválido' >&2; exit 1; }
    destination="${3:?Indicá la ruta local .tar.age}"
    [[ "$destination" == *.tar.age ]] || { echo 'El destino debe terminar en .tar.age' >&2; exit 1; }
    rclone copyto "${backup_remote%/}/$name" "$destination" --immutable --quiet
    chmod 600 "$destination"
    echo 'Backup cifrado descargado. Verificá y descifrá con verify-backup.'
    ;;
  prepare)
    backup_open_source "${2:?Indicá el archivo local .tar.age}"
    destination="${3:?Indicá un directorio privado nuevo}"
    [[ ! -e "$destination" ]] || { echo 'El directorio de preparación ya existe' >&2; exit 1; }
    mkdir -m 700 "$destination"
    cp -a "$backup_source/." "$destination/"
    echo 'Preparado en un directorio privado SIN cifrar. Eliminalo al terminar la recuperación.'
    ;;
  *) echo 'Uso: bin/backup-remote list | fetch NOMBRE ARCHIVO_LOCAL.tar.age | prepare LOCAL.tar.age DIRECTORIO_PRIVADO_NUEVO' >&2; exit 1 ;;
esac
