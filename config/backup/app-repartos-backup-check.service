[Unit]
Description=Check App Repartos external backup freshness and existence
After=network-online.target
Wants=network-online.target
OnFailure=app-repartos-backup-alert@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/app-repartos/backup.env
ExecStart=/usr/local/lib/app-repartos/bin/check-backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/app-repartos
TimeoutStartSec=5m
