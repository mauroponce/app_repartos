[Unit]
Description=App Repartos encrypted external backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=app-repartos-backup-alert@%n.service

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/app-repartos/backup.env
ExecStart=/usr/local/lib/app-repartos/bin/vps-backup
UMask=0077
Nice=15
IOSchedulingClass=idle
CPUWeight=10
IOWeight=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/app-repartos
TimeoutStartSec=6h
