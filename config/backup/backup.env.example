# Install at /etc/app-repartos/backup.env, owner root, mode 0600. No secrets in Git.
BACKUP_DIR=/var/backups/app-repartos
APP_STORAGE_DIR=/var/lib/app-repartos/storage
POSTGRES_CONTAINER=app-repartos-db
POSTGRES_ADMIN_USER=postgres
PRIMARY_DATABASE_NAME=app_repartos_production
QUEUE_DATABASE_NAME=app_repartos_production_queue
AGE_RECIPIENT=age1_REPLACE_WITH_PUBLIC_RECIPIENT
RCLONE_CONFIG=/etc/app-repartos/rclone.conf
BACKUP_RCLONE_REMOTE=r2-backups:PRIVATE_BACKUP_BUCKET/production/app-repartos
BACKUP_KEEP=7
BACKUP_REMOTE_RETENTION_DAYS=30
BACKUP_MAX_AGE_HOURS=36
BACKUP_MIN_FREE_BYTES=536870912
BACKUP_APP_VERSION=SET_DEPLOYED_COMMIT_OR_IMAGE_VERSION
# Optional monitoring endpoint; root file only. No customer data is sent.
BACKUP_ALERT_WEBHOOK=
# If the app's Active Storage uses R2, a separate read-only media remote is required.
# BACKUP_MEDIA_REMOTE=r2-media:PRIVATE_MEDIA_BUCKET
# Never copy AGE_IDENTITY_FILE/private keys onto the backup VPS for daily backups.
# Restore-test host only; enable freshness checking there after a successful test.
# BACKUP_REQUIRE_VERIFIED=1
# BACKUP_VERIFY_MAX_AGE_DAYS=7
