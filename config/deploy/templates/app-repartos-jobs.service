[Unit]
Description=App Repartos - Solid Queue
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/var/www/app_repartos/current
Environment=PATH=/opt/ruby/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/var/www/app_repartos/shared/.env.production
ExecStart=/opt/ruby/bin/bundle exec ruby bin/jobs
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
UMask=0027

[Install]
WantedBy=multi-user.target
