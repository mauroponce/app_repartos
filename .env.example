# Docker Compose already defines local services. These variables are for the VPS.
RAILS_ENV=production
APP_HOST=repartos.example.com
DATABASE_URL=postgresql://repartos:CHANGE_ME@127.0.0.1/app_repartos_production
SECRET_KEY_BASE=GENERATE_WITH_bin_rails_secret
RAILS_MAX_THREADS=5
JOB_CONCURRENCY=1
PORT=3000
QUEUE_DATABASE_URL=postgresql://repartos:CHANGE_ME@127.0.0.1/app_repartos_production_queue
PHOTON_URL=https://photon.komoot.io/api/
OSM_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
