# Optional application env reference. Compose defines local values; production
# uses config/deploy.yml + .kamal/secrets (never copy this file into an image).
RAILS_ENV=production
APP_HOST=repartos.example.com
DATABASE_HOST=app-repartos-db
DATABASE_USERNAME=repartos
DATABASE_PASSWORD=SET_APPLICATION_DATABASE_PASSWORD
SECRET_KEY_BASE=GENERATE_WITH_bin_rails_secret
RAILS_MAX_THREADS=5
JOB_CONCURRENCY=1
PORT=3000
# Optional URL overrides only when the defaults in config/database.yml differ:
# DATABASE_URL=
# QUEUE_DATABASE_URL=
PHOTON_URL=https://photon.komoot.io/api/
OSM_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Private VROOM Express endpoint backed by OSRM/Valhalla street data.
# Only coordinates, anonymous job/vehicle IDs, loads and time constraints are sent.
# Leave blank for manual planning. Local stack: compose.routing.yml and bin/prepare-routing.
VROOM_URL=
# Private R2 bucket. Use an API key limited to object read/write on this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Blank: keep uploaded evidence. Positive days: purge files of synced receipts
# after this age, retaining receipt metadata. Conflicts are always kept.
DELIVERY_EVIDENCE_RETENTION_DAYS=

# OSRM HTTP endpoint, reachable from web/worker, for routing and live ETA.
# Compose uses osrm; Kamal sets http://app-repartos-osrm:5000 internally.
OSRM_URL=http://osrm:5000
# Solo para un OSRM externo sin manifest local: identificar su mapa activo.
# Cambiar este valor al actualizar los datos viales. Sin versión conocida,
# se omite la caché persistente para evitar reutilizar cálculos obsoletos.
# OSRM_MAP_VERSION=

# Opcional: purgar fotos de incidencias cerradas después de estos días.
# Sin valor se conservan; los metadatos y la auditoría nunca se purgan.
INCIDENT_PHOTO_RETENTION_DAYS=

# New single-VPS installations use private persistent local files in production.
# Existing R2 installations must keep ACTIVE_STORAGE_SERVICE=r2 and R2 secrets
# until existing blobs are explicitly migrated. Disk does not migrate R2 blobs.
ACTIVE_STORAGE_SERVICE=persistent
# Deployment metadata (replace placeholders before any actual Kamal operation).
# DEPLOY_HOST=
# DEPLOY_SSH_USER=
# APP_HOST=
# DEPLOY_ARCH=amd64
